{
  "name": "@aip/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "grant:document": "tsx scripts/grant-document.ts"
  },
  "dependencies": {
    "@aip/contracts": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.3.0",
    "jose": "6.2.13",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "pino": "9.14.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
