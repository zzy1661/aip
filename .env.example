# aip 环境变量示例
#
# 复制为 .env 后按部署环境填写。所有值都是占位符，不含任何真实凭据。
# 变量名必须与 services/api/src/config.ts 的 loadConfig() 完全一致；
# 缺失的必填项会在启动时直接失败（不做静默降级）。
#
# 密钥类变量（RAGFLOW_API_KEY、AUTH_HS256_SECRET、DATABASE_URL 中的口令）
# 仅从环境变量读取：禁止写入代码、禁止落库、禁止进入日志与前端产物。
#
# 本文件只列产品代码实际会读取的运行时变量（见 services/api/src/config.ts、
# services/api/src/main.ts、services/api/src/db/migrate.ts、services/worker/src/main.ts）。
# compose 专用变量（数据库角色口令、镜像名）由 compose 自己消费，不由产品代码读取，
# 见 deploy/.env.example。
# 两侧清单的一致性由 tests/contract/runbook-config-consistency.test.ts 断言。

# ---------------------------------------------------------------- 运行时
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# 部署作用域，同时是数据隔离键与 URL 路径段 /api/v1/projects/{projectId}
AIP_PROJECT_ID=<project-id>
# 可信代理声明
AIP_TRUSTED_PROXY=

# ---------------------------------------------------------------- 数据库与文件
# aip 独占的 PostgreSQL；账本表 aip_schema_migration 会自动创建
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
# 受控文件存储根目录（来源文件正文），storage_key 由服务端生成
AIP_FILE_STORE_ROOT=/var/lib/aip/files
# 迁移目录覆盖（仅在源码与构建产物路径不一致时需要）
AIP_MIGRATIONS_DIR=

# ---------------------------------------------------------------- 鉴权
# jwks | hs256；NODE_ENV=production 时必须为 jwks
AUTH_MODE=jwks
OIDC_ISSUER=https://<issuer>
OIDC_AUDIENCE=<audience>
OIDC_JWKS_URI=https://<issuer>/.well-known/jwks.json
# 仅 AUTH_MODE=hs256 时使用；仅从环境变量读取，禁止入库、禁止落日志
AUTH_HS256_SECRET=<hs256-secret>

# ---------------------------------------------------------------- RAGFlow 上游
# 契约版本必须为 v0.20.5，其他取值启动失败（换版本需先复核契约）
RAGFLOW_API_VERSION=v0.20.5
RAGFLOW_BASE_URL=http://<ragflow-host>:9380
# 仅从环境变量读取，禁止入库、禁止落日志
RAGFLOW_API_KEY=<ragflow-api-key>
# 嵌入模型与修订号：生产必须显式固定，缺省时索引记录为 unversioned
RAGFLOW_EMBEDDING_MODEL=
RAGFLOW_EMBEDDING_REVISION=
# 分块方法与解析器配置
RAGFLOW_CHUNK_METHOD=naive
RAGFLOW_PARSER_CONFIG_JSON={}
# 出口超时与只读重试预算
RAGFLOW_CONNECT_TIMEOUT_MS=3000
RAGFLOW_READ_TIMEOUT_MS=10000
RAGFLOW_UPLOAD_TIMEOUT_MS=60000
RAGFLOW_READ_BUDGET_MS=30000
RAGFLOW_READ_MAX_ATTEMPTS=3
# 检索参数
RAGFLOW_SIMILARITY_THRESHOLD=0.2
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.3
RAGFLOW_TOP_K=1024
# 锁定信息：生产落地前必须填成真实值，缺省时 parser_hash 记为 unpinned
RAGFLOW_IMAGE_DIGEST=
RAGFLOW_SOURCE_SHA=

# ---------------------------------------------------------------- 本体（onto）概念校验
# 未配置时概念校验一律判为不通过，不会降级为通过
ONTO_BASE_URL=
ONTO_API_AUDIENCE=

# ---------------------------------------------------------------- 平台限额
AIP_UPLOAD_MAX_BYTES=20971520
AIP_PARSE_DEADLINE_MS=1200000
AIP_RETRIEVAL_MAX_DOCUMENTS=200
# 操作租约时长：必须大于「上传超时 + 只读预算 + 30 秒余量」，否则启动失败
AIP_OPERATION_LEASE_MS=120000

# ---------------------------------------------------------------- Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=10

# ---------------------------------------------------------------- 真实 RAGFlow 联调
# 置 1 才会真正执行 tests/real/ 下的用例；缺配置时该层必须非零退出
RUN_REAL_RAGFLOW=
RAGFLOW_TEST_PROJECT_ID=
