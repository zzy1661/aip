# aip compose 专用环境变量示例
#
# 复制为 deploy/.env 后按部署环境填写（compose 从同目录读取）。
# 这里只放**由 compose 自己消费**的变量：数据库角色口令与镜像名。
# 产品代码实际读取的运行时变量在仓库根 .env.example。
#
# 角色分离（见 docs/runbook.md 第 3.1 节）：
# - 迁移角色（数据库属主）只有 DDL 权限，只给 migrate 步骤用；
# - 应用角色只有业务读写权限、没有 DDL，api 与 worker 都用它。

# ---------------------------------------------------------------- 镜像名
# compose 示例里的镜像名与标签是占位符，需要替换成实际构建产物
AIP_API_IMAGE=<aip-api-image:tag>
AIP_MIGRATE_IMAGE=<aip-api-image:tag>
AIP_WORKER_IMAGE=<aip-worker-image:tag>

# ---------------------------------------------------------------- 数据库角色
# 迁移角色：数据库属主，只有 DDL 权限；只给 migrate 步骤用
POSTGRES_USER=<migration-user>
POSTGRES_PASSWORD=<migration-password>
POSTGRES_DB=<database>
# 应用角色：只有业务读写权限，没有 DDL；api 与 worker 都用它
POSTGRES_APP_USER=<app-user>
POSTGRES_APP_PASSWORD=<app-password>
