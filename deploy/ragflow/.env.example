# aip 本地 RAGFlow 栈的环境变量模板
#
# 用法：cp .env.example .env 后把 <replace-me> 换成本地随机值，然后
#   docker compose --env-file .env -f compose.yaml up -d
# .env 已被仓库 .gitignore 忽略，禁止提交；本文件只放占位符，不放任何真实口令。

# 文档引擎与时区
DOC_ENGINE=elasticsearch
TIMEZONE=Asia/Shanghai
MACOS=1

# Elasticsearch（宿主端口已从官方 1200 后移，避开本机已有的 ragflow-es-01）
ES_HOST=es01
ES_PORT=19200
ELASTIC_PASSWORD=<replace-me>
ES_JAVA_OPTS=-Xms1g -Xmx1g
ES_MEM_LIMIT=2147483648

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=15455
MYSQL_DBNAME=rag_flow
MYSQL_PASSWORD=<replace-me>

# MinIO（对象存储）
MINIO_HOST=minio
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_USER=rag_flow
MINIO_PASSWORD=<replace-me>

# Valkey（Redis 协议）
REDIS_HOST=redis
REDIS_PORT=16379
REDIS_PASSWORD=<replace-me>

# RAGFlow 服务本体
SVR_HTTP_PORT=19380
# 用于会话与 API token 签名，长度需 >= 32
RAGFLOW_SECRET_KEY=<replace-me>
REGISTER_ENABLED=1
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16
# 宿主机无法访问 huggingface.co 时才需要，例如 https://hf-mirror.com
HF_ENDPOINT=
